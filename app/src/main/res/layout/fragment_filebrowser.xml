<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/colorPrimary"
        android:orientation="horizontal"
        android:padding="6dp">

        <TextView
            android:id="@+id/currentPath"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:singleLine="true"
            android:ellipsize="start"
            android:textColor="?attr/colorOnPrimary"
            android:padding="6dp"
            android:textSize="12sp" />

        <ImageButton
            android:id="@+id/btnNewFolder"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_folder"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/file_create_folder" />

        <ImageButton
            android:id="@+id/btnNewFile"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_file"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/file_create_file" />

        <ImageButton
            android:id="@+id/btnImport"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_import"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/file_import" />

        <ImageButton
            android:id="@+id/btnGit"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_git"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/git_menu" />

        <ImageButton
            android:id="@+id/btnRefresh"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:src="@drawable/ic_refresh"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/action_refresh" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fileTreeRecycler"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="4dp" />

    <TextView
        android:id="@+id/emptyHint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:textStyle="italic"
        android:visibility="gone"
        android:text="@string/file_empty_dir" />
</LinearLayout>
