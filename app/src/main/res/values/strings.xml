    <string name="onboarding_title">Welcome</string>
    <string name="onboarding_welcome_title">A pocket Linux IDE</string>
    <string name="onboarding_welcome_body">A terminal, a code editor, and a real Linux toolchain — all in your pocket. No root required.</string>
    <string name="onboarding_downloads_title">First-run setup</string>
    <string name="onboarding_downloads_body">We\'ll fetch a minimal Alpine Linux rootfs (~3 MB), the PRoot binary (~1.5 MB), and the CodeMirror editor (~500 KB). One-time only.</string>
    <string name="onboarding_finish_title">Ready to code</string>
    <string name="onboarding_finish_body">Open the editor on top, run commands below. Use <b>apk add</b> inside the terminal to install gcc, python, git, and more.</string>
