    <!-- About -->
    <string name="about_blurb">LowLevelIDE bundles a Termux-style terminal emulator and a CodeMirror editor on top of a sandboxed Alpine Linux. Built for tinkerers who want a real Linux toolchain on Android — root or no root.</string>
    <string name="about_version">Version</string>
    <string name="about_built_on">Built on</string>
    <string name="about_open_source">Open-source components</string>
    <string name="about_termux">Termux terminal-view / terminal-emulator (GPLv3)</string>
    <string name="about_codemirror">CodeMirror 5 (MIT)</string>
    <string name="about_alpine">Alpine Linux minirootfs (various FOSS)</string>
    <string name="about_proot">PRoot (GPLv2)</string>

