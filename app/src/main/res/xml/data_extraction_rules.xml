<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="home/" />
        <exclude domain="file" path="bootstrap/" />
        <exclude domain="file" path="tmp/" />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="home/" />
        <exclude domain="file" path="bootstrap/" />
        <exclude domain="file" path="tmp/" />
    </device-transfer>
</data-extraction-rules>
